params {
    metadata      = "${projectDir}/data/data_raw/colombia_metadata.csv"
    outdir        = "${projectDir}/results"
    max_sra_size  = '50G'
}

process {
    withLabel: sra_download {
        cpus        = 4
        memory      = '8 GB'
        // be polite to NCBI: few concurrent downloads, limited retries with backoff
        maxForks    = 2
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries  = 2
    }
}

profiles {
    conda {
        conda.enabled = true
        conda.useMamba = false
    }
}

report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.svg" }
