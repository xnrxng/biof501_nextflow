manifest {
    name            = 'biof501-16s-pipeline'
    description     = '16S amplicon pipeline: DADA2, taxonomy, diversity, differential abundance, network'
    version         = '1.0.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    // ---- input ----
    metadata      = "${projectDir}/data/data_raw/colombia_metadata.csv"  // first column(s): SRR accessions
    variable      = 'adiponectin'     // metadata column to compare samples by
    variable_type = 'auto'            // auto | numeric | categorical
    outdir        = "${projectDir}/results"
    rawdir        = "${projectDir}/data/data_raw"        // downloaded FASTQs
    procdir       = "${projectDir}/data/data_processed"  // ASV table + sequences

    // ---- download ----
    max_sra_size  = '20G'
    max_reads     = 0                 // reads (pairs) kept per sample; 0 = all (default). e.g. --max_reads 20000 for a quick test

    // ---- DADA2 ----
    trunc_len_f   = 'auto'            // 'auto' (Q30 rule), 0 (none) or an integer
    trunc_len_r   = 'auto'
    trim_left_f   = 0                 // set to primer length if primers are still present
    trim_left_r   = 0
    max_ee        = 2

    // ---- taxonomy ----
    silva_db      = 'https://zenodo.org/records/4587955/files/silva_nr99_v138.1_train_set.fa.gz'
    silva_version = 'SILVA nr99 v138.1 (Zenodo 4587955)'
    min_boot      = 50

    // ---- analysis ----
    min_depth     = 1000              // drop samples with fewer reads after filtering
    tax_level     = 'genus'           // genus | asv
    seed          = 42
    da_binarize   = 'none'            // none | median (numeric variables only: low/high split)
    da_alpha      = 0.1
    da_min_prev   = 0.2
    net_min_prev  = 0.3
    net_cor       = 0.6               // minimum |Spearman rho|
    net_p         = 0.05
    net_padj_method = 'none'          // none | BH | ...
    net_max_nodes = 60
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: process_low  { cpus = 2; memory = '4 GB' }
    withLabel: process_high { cpus = 6; memory = '8 GB' }
    withLabel: sra_download {
        cpus          = 4
        memory        = '4 GB'
        // be polite to NCBI: few concurrent downloads, limited retries
        maxForks      = 2
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries    = 2
    }
}

// Docker is the default; use -profile conda / singularity to switch.
docker.enabled = true

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    // Apple Silicon / arm64 Linux: the biocontainers are amd64, so run them under emulation
    arm64 {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g) --platform linux/amd64'
    }
    singularity {
        docker.enabled          = false
        singularity.enabled     = true
        singularity.autoMounts  = true
    }
    conda {
        docker.enabled = false
        conda.enabled  = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}

report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }
